          "415": {
            "description": "Unsupported media type (unsupported_media_type)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed (validation); Idempotency key reused with a different payload (idempotency_mismatch)",
