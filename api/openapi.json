  "components": {
    "schemas": {
      "AddLine": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Stock keeping unit",
            "minLength": 1,
            "pattern": "^[A-Z0-9-]{3,32}$"
          },
          "qty": {
            "type": "integer",
            "description": "Quantity ordered",
            "minimum": 1,
            "maximum": 1000
          },
          "unitPrice": {
            "type": "integer",
            "description": "Unit price in minor currency units (cents)",
            "minimum": 0
          }
        },
        "required": [
          "sku",
          "qty"
        ],
        "additionalProperties": false
      },
      "CreateOrder": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid",
            "description": "Customer placing the order",
            "minLength": 1
          },
          "lines": {
            "type": "array",
            "description": "Initial lines; at least one, SKUs distinct",
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "customerId",
          "lines"
        ],
        "additionalProperties": false
      },
      "CreateOrderResult": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "Identifier of the new order (UUID)"
          }
        },
        "additionalProperties": false
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OrderEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Monotonic event ID within the order; sent as the SSE id"
          },
          "orderId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "created",
              "line_added",
              "submitted"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": [
              "object",
              "null"
            ],
            "description": "Event-specific fields",
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      },
