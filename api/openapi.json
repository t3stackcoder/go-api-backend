{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Orders",
    "description": "Example order service of the mediator framework (spec section 13). Every operation is one registered request; the document is generated from the registry.",
    "version": "1.0.0"
  },
  "paths": {
    "/orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "List the orders of a customer",
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "customerId",
            "in": "query",
            "description": "Customer whose orders are listed",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "minLength": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "1-based page number; default 1",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size; default 20, at most 100",
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Mediator-Cache": {
                "description": "Whether the response came from the cache.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "hit",
                    "miss",
                    "bypass"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_github.com_t3stackcoder_go-api-backend_examples_orders_orders.OrderSummary_"
